# ============================================================
# hentaiviewer bot 配置模板
# 使用方法: cp .env.example .env 然后填写自己的值
# 克隆部署: 直接运行 ./setup.sh 交互式生成（推荐）
# ============================================================

# --- Telegram 必填 ---
# BotFather (https://t.me/BotFather) 创建的 bot token
EHBOT_TELEGRAM_TOKEN=

# 私聊白名单用户 ID（逗号分隔）。EHBOT_PUBLIC_ACCESS=1 时私聊全开放。
# 群模式下群成员不受此限制。
EHBOT_ALLOWED_USERS=

# 管理员（owner）用户 ID，免每日配额。默认 1601156128
#EHBOT_OWNER_USERS=

# 1=公开访问（非 owner 受每日配额限制），0=仅白名单
#EHBOT_PUBLIC_ACCESS=1

# 普通用户每日配额（UTC+8 零点重置）
#EHBOT_DAILY_LIMIT=10

# --- 以图搜图（可选增强） ---
# IQDB 无 key 免费启用；Saucenao 增强覆盖 Pixiv/Twitter 等。
# Saucenao 注册: https://saucenao.com → account → API Key
# 多个 key 用逗号分隔，自动轮询：key1,key2,key3（约 100N 次/天）
SAUCENAO_API_KEY=

# --- 群模式（可克隆部署的核心） ---
# 1=允许拉进群组使用；0=仅私聊
EHBOT_GROUP_MODE=1

# 群白名单 chat_id（逗号分隔）。留空=任意群可用。
# 获取群 ID: 群里发消息给 @userinfobot 或 @getidsbot
#EHBOT_GROUP_ALLOWED_CHATS=-1001234567890

# --- 抓取 ---
# 并发抓图 worker 数
#EHBOT_MAX_WORKERS=5
# 单画廊最大页数（0=不限）
#EHBOT_MAX_PAGES=0
# 18comic 登录 cookies（F12 → Application → Cookies → 18comic.vip）
#EHBOT_JM_COOKIES=

# --- 图片托管 ---
# catbox 或 static（本地静态目录）
#EHBOT_IMAGE_HOST=catbox
#EHBOT_CATBOX_USERHASH=
#EHBOT_STATIC_IMAGE_ROOT=/var/www/hentaiviewer
#EHBOT_STATIC_IMAGE_BASE_URL=https://your-domain.com
#EHBOT_STATIC_IMAGE_TTL_SECONDS=86400

# --- Telegraph ---
# Telegraph 账号 token 存储路径（默认 ~/.hermes/telegraph_token.json）
# 建议改为项目目录，克隆部署无需 ~/.hermes 权限
#EHBOT_TELEGRAPH_TOKEN_FILE=./.telegraph_token.json

# 每日排行推送到频道（可选）
#STORE_CHANNEL_CHAT_ID=
#STORE_BOT_TOKEN=
#DAILY_RANKING_COMIC_TELEGRAPH=0
